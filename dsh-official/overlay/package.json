{
  "name": "dsh-overlay-custom",
  "version": "0.1.0",
  "private": true,
  "description": "Custom features on top of official DSH Desktop: relay, model extras, Codex/xAI OAuth",
  "license": "MIT",
  "type": "module",
  "files": [
    "cordis.patch.yml",
    "public",
    "src",
    "lib"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --experimental-strip-types --test scripts/check.ts",
    "bundle:client": "esbuild src/client/index.ts --bundle --format=cjs --outfile=lib/client.js --jsx=automatic --external:react --external:react/jsx-runtime --external:react-dom --external:@deepseek-ai/cordis --external:@deepseek-ai/dsh-client-ui-slots --external:@deepseek-ai/dsh-client-ui-settings-models --external:@deepseek-ai/dsh-client-ui-settings-models/client --external:@deepseek-ai/dsh-client-ui-sidebar --external:@deepseek-ai/dsh-client-ui-sidebar/client --external:@deepseek-ai/dsh-client-ui-settings --external:@deepseek-ai/dsh-client-ui-settings/client --banner:js='window.__ModuleLoader__.load({id:\"dsh-overlay-custom\",factory:(require)=>{var module={exports:{}};var exports=module.exports;' --footer:js='return module.exports;}});'",
    "bundle:host": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=lib/index.js --packages=external",
    "bundle": "pnpm run bundle:host && pnpm run bundle:client"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "undici": "^8.11.2",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
