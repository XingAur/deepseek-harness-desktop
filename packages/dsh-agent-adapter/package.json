{
  "name": "@dsh/agent-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/protocol.js",
  "types": "lib/types/protocol.d.ts",
  "bin": {
    "dsh-agent-worker": "lib/agent-worker.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    },
    "./adapters": {
      "types": "./lib/types/adapters/index.d.ts",
      "default": "./lib/adapters.js"
    },
    "./providers/openai-compatible": {
      "types": "./lib/types/providers/openai-compatible.d.ts",
      "default": "./lib/providers/openai-compatible.js"
    },
    "./mcp": {
      "types": "./lib/types/mcp/client.d.ts",
      "default": "./lib/mcp.js"
    },
    "./mcp/oauth": {
      "types": "./lib/types/mcp/oauth.d.ts",
      "default": "./lib/mcp-oauth.js"
    },
    "./harness-bridge": {
      "types": "./lib/types/harness-bridge.d.ts",
      "default": "./lib/harness-bridge.js"
    },
    "./harness-host-handler": {
      "types": "./lib/types/harness-host-handler.d.ts",
      "default": "./lib/harness-host-handler.js"
    },
    "./harness-task-session": {
      "types": "./lib/types/harness-task-session.d.ts",
      "default": "./lib/harness-task-session.js"
    },
    "./harness-capability-map": {
      "types": "./lib/types/harness-capability-map.d.ts",
      "default": "./lib/harness-capability-map.js"
    },
    "./deepseek-harness-executor": {
      "types": "./lib/types/deepseek-harness-executor.d.ts",
      "default": "./lib/deepseek-harness-executor.js"
    }
  },
  "files": ["lib/**"],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run --root ../.. packages/dsh-agent-adapter/src"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
