{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness Desktop",
        "decorations": false,
        "shadow": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
