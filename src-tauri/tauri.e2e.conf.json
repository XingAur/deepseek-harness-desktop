{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Desktop E2E",
  "identifier": "ai.deepseek.harness.desktop.e2e",
  "build": {
    "beforeBuildCommand": "npm run build:web:e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "packaged-e2e",
          "description": "Webdriver capability compiled only into explicit E2E candidates.",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyRjczNUMwNTUxQzUzRkMKUldUOFV4eFZ3RFgzWXAwZEU1QmkxV1RGc3JRVWQxN09oNU9SMWsydmQ3WjF6UXdOTE5VRkg2NmMK",
      "endpoints": ["https://github.com/XingAur/deepseek-harness-desktop/releases/latest/download/latest.json"],
      "dangerousAcceptInvalidCerts": true,
      "windows": { "installMode": "passive" }
    }
  }
}
