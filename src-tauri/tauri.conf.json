{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Desktop",
  "mainBinaryName": "deepseek-harness-desktop",
  "version": "0.1.29",
  "identifier": "ai.deepseek.harness.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web && npm run agent:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DeepSeek Harness Desktop",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "resources": {
      "../packages/dsh-agent-adapter/lib": "agent-adapter",
      "../plugin-catalog": "plugin-catalog"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyRjczNUMwNTUxQzUzRkMKUldUOFV4eFZ3RFgzWXAwZEU1QmkxV1RGc3JRVWQxN09oNU9SMWsydmQ3WjF6UXdOTE5VRkg2NmMK",
      "endpoints": [
        "https://github.com/XingAur/deepseek-harness-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
