{
  "name": "deepseek-harness-desktop",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -b && vite build",
    "build:web:e2e": "tsc -b && vite build --mode e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "plugin:build": "npm run build -w @dsh/desktop-plugin",
    "plugin:test": "npm run test -w @dsh/desktop-plugin",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "e2e:installer": "vitest run --config vitest.e2e.config.ts",
    "e2e:setup:build": "node scripts/e2e/build-instrumented-setup.mjs",
    "e2e:build": "tauri build --features e2e --config src-tauri/tauri.e2e.conf.json --no-bundle",
    "e2e:fixtures": "vitest run scripts/e2e",
    "check": "npm run test && npm run plugin:test && npm run build:web && npm run plugin:build",
    "tauri": "tauri",
    "runtime:build": "node scripts/build-runtime.mjs",
    "release:versions:check": "node scripts/release-versions.mjs --check",
    "release:prepare": "node scripts/prepare-upstream-release.mjs",
    "release:metadata": "node scripts/desktop-release.mjs",
    "runtime:source-config": "node scripts/write-runtime-source-config.mjs",
    "updater:config": "node scripts/write-updater-config.mjs",
    "installer:verify": "node scripts/verify-nsis-template.mjs",
    "installer:windows": "node scripts/windows-installer.mjs",
    "icon:verify": "node scripts/verify-windows-icon.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.2.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.5",
    "@wdio/cli": "^9.31.1",
    "@wdio/globals": "^9.31.1",
    "@wdio/local-runner": "^9.31.1",
    "@wdio/mocha-framework": "^9.31.1",
    "@wdio/spec-reporter": "^9.31.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "esbuild": "0.28.2",
    "jsdom": "28.1.0",
    "selfsigned": "^3.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "webdriverio": "^9.31.1"
  }
}
