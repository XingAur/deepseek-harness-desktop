{
  "name": "deepseek-harness-desktop",
  "private": true,
  "description": "DSH Desktop: the official DeepSeek Harness desktop app plus a local Cordis overlay",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "official:bootstrap": "bash scripts/bootstrap.sh",
    "official:sync": "bash scripts/update-official.sh",
    "official:start": "bash scripts/start-official.sh",
    "official:status": "bash scripts/status.sh",
    "overlay:install": "bash scripts/install-overlay.sh",
    "check:overlay": "node --experimental-strip-types --test overlay/scripts/check.ts",
    "check:scripts": "node --test scripts/test-finalize-portable-runtime.mjs scripts/test-repack-portable-asar.mjs",
    "check": "bash scripts/check.sh",
    "build:win": "pwsh -NoProfile -File scripts/build-portable-windows-x64.ps1",
    "build:mac": "bash scripts/build-portable-macos-arm64.sh"
  }
}
