{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "his-capability-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin", "plugin_version", "capabilities"],
  "properties": {
    "schema_version": {"const": "his-capabilities.v1"},
    "plugin": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "plugin_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "capabilities": {
      "type": "array",
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "provider", "contract_version", "mutation_level",
        "credential_class", "enabled", "scopes"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "provider": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "contract_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "mutation_level": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
        "credential_class": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "entrypoint": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "enabled": {"type": "boolean"},
        "disabled_reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {"required": ["entrypoint"]}
        },
        {
          "if": {"properties": {"enabled": {"const": false}}, "required": ["enabled"]},
          "then": {"required": ["disabled_reason"]}
        }
      ]
    }
  }
}
