{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://his-harness.local/schemas/harness_config_layer.v1.json",
  "title": "HIS Harness Configuration Layer v1",
  "type": "object",
  "required": ["schema_version", "layer", "config"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "layer": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["team_package", "project_config", "personal_override", "run_override"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "merge_policies": {
      "type": "object",
      "additionalProperties": {"enum": ["replace", "merge", "append", "union", "remove", "locked"]}
    },
    "config": {"type": "object"}
  }
}
